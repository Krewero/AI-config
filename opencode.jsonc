{
  // Schema ufficiale per validation/autocomplete editor
  "$schema": "https://opencode.ai/config.json",

  //Plugins
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-beads@latest",
    "@tarquinen/opencode-dcp@latest"
  ],

  //Configurazione server locale OpenCode
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "cors": ["http://localhost:5173"]
  },

  //Agente impostato di default
  "default_agent": "plan",

  //Impostazione aggiornamento automatico
  "autoupdate": "notify",

  //Impostazione condivisione sessioni
  "share": "disabled",

  //Tema predefinito
  "theme": "ayu-dark",

  //TUI: Impostazioni terminale
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": { "enabled": true },
    "diff_style": "auto"
  },

  //Watcher ignore: Directory da ignorare
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".gitattributes/**",
      ".evo/**",
      ".yo-rc.json",
      "yo-rc-global.json"
    ]
  },

  //Compaction: Token compation
  "compaction": {
    "auto": true,
    "prune": true
  },

  //Permission baseline
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "task": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "agents": {
    "Command_Runner": {
      "description": "Specialized agent for executing user-provided shell commands, initialization routines. Strictly limited to command execution and basic file creation like tasks.yaml; does not plan, write code, or perform analysis.",
      "prompt": "{file:./prompts/command_runner.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": ["bash", "list", "glob", "write"],
      "max_steps": 5,
      "temperature": 0.1
    },

    "Task_Manager": {
      "description": "Manages tasks.yaml file: creates new tasks from user input, updates status (TODO/DOING/DONE/BLOCKED/SKIP), adds notes/paths, integrates beads for session-persistent memory. Reads project context and tasks history; no code implementation or planning.",
      "prompt": "{file:./prompts/task_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "allow",
        "task": "allow"
      },
      "tools": ["read", "write", "edit", "glob", "bash", "task", "skill"],
      "max_steps": 10,
      "temperature": 0.2
    },

    "Code_Reviewer": {
      "description": "Reviews generated code changes and diffs against tasks.yaml and software engineering best practices. Evaluates code quality, scalability, and maintainability. Approves solid implementations or rejects with actionable feedback for re-planning.",
      "prompt": "{file:./prompts/code_reviewer.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "task": "deny"
      },
      "tools": ["read", "glob", "grep", "lsp", "bash", "skill", "webfetch"],
      "max_steps": 10,
      "temperature": 0.1
    },

    "Repo_Manager": {
      "description": "Generates commit commands for personal Git and company SVN repositories. Suggests conventional messages from tasks.yaml, shows status/diffs, provides copy-paste shell sequences for both.",
      "prompt": "{file:./prompts/repo_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": ["bash", "glob", "grep", "read", "list", "write", "skill"],
      "max_steps": 8,
      "temperature": 0.1
    }
  }
}