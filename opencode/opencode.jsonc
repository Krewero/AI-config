{
  // Schema ufficiale per validation/autocomplete editor
  "$schema": "https://opencode.ai/config.json",

  //Plugins
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-beads@latest",
    "@tarquinen/opencode-dcp@latest"
  ],

  //Configurazione server locale OpenCode
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "cors": ["http://localhost:5173"]
  },

  //Agente impostato di default
  "default_agent": "plan",

  //Impostazione aggiornamento automatico
  "autoupdate": "notify",

  //Impostazione condivisione sessioni
  "share": "disabled",

  //Tema predefinito
  "theme": "ayu-dark",

  //TUI: Impostazioni terminale
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": { "enabled": true },
    "diff_style": "auto"
  },

  //Watcher ignore: Directory da ignorare
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".gitattributes/**",
      ".evo/**",
      ".yo-rc.json",
      "yo-rc-global.json"
    ]
  },

  //Compaction: Token compation
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Permission baseline (nota: git* / github* qui sono solo policy, il gating reale è in "tools")
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "task": "allow",
    "edit": "allow",
    "bash": "allow",
    "git*": "allow",
    "github*": "allow",
    "memory*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "tools": {
    "git*": false,
    "github*": false,
    "memory*": false
  },

  "agent": {
    "Command_Runner": {
      "description": "Specialized agent for executing user-provided shell commands, initialization routines. Strictly limited to command execution and basic file creation like tasks.yaml; does not plan, write code, or perform analysis.",
      "prompt": "{file:./prompts/command_runner.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": {
        "bash": true,
        "list": true,
        "glob": true,
        "write": true,
        "git*": false,
        "github*": false
      },
      "max_steps": 5,
      "temperature": 0.1
    },

    "Task_Manager": {
      "description": "Manages tasks.yaml file: creates new tasks from user input, updates status (TODO/DOING/DONE/BLOCKED/SKIP), adds notes/paths, integrates beads for session-persistent memory. Reads project context and tasks history; no code implementation or planning.",
      "prompt": "{file:./prompts/task_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "allow",
        "task": "allow"
      },
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "bash": true,
        "task": true,
        "skill": true,
        "git*": false,
        "github*": false,
        "memory*": true
      },
      "max_steps": 10,
      "temperature": 0.2
    },

    "plan": {
      "tools": {
        "git*": true,
        "github*": true,
        "memory*": true
      }
    },

    "Code_Reviewer": {
      "description": "Reviews generated code changes and diffs against tasks.yaml and software engineering best practices. Evaluates code quality, scalability, and maintainability. Approves solid implementations or rejects with actionable feedback for re-planning.",
      "prompt": "{file:./prompts/code_reviewer.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "task": "deny"
      },
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "bash": true,
        "skill": true,
        "webfetch": true,
        "git*": false,
        "github*": false
      },
      "max_steps": 10,
      "temperature": 0.1
    },

    "Repo_Manager": {
      "description": "Generates commit commands for personal Git and company SVN repositories. Suggests conventional messages from tasks.yaml, shows status/diffs, provides copy-paste shell sequences for both.",
      "prompt": "{file:./prompts/repo_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": {
        "bash": false,
        "glob": true,
        "grep": true,
        "read": true,
        "list": true,
        "write": true,
        "skill": true,
        "git*": true,
        "github*": true
      },
      "max_steps": 8,
      "temperature": 0.1
    }
  },

  "mcp": {
    "git": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "@cyanheads/git-mcp-server"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "GIT_SIGN_COMMITS": "false"
      },
      "enabled": true,
      "timeout": 15000
    },

    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "default",
        "X-MCP-Readonly": "true",
        "Authorization": "Bearer {env:OC_GITHUB_PAT}"
      },
      "enabled": true,
      "timeout": 15000
    },

    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "{env:USERPROFILE}\\.config\\opencode\\memory.jsonl"
      },
      "enabled": true,
      "timeout": 15000
    }
  }
}
