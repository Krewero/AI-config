{
  // Official schema for validation and editor autocomplete
  "$schema": "https://opencode.ai/config.json",

  // OpenCode plugins to load
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-beads@latest",
    "@tarquinen/opencode-dcp@latest"
  ],

  // Local OpenCode server configuration
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "cors": ["http://localhost:5173"]
  },

  // Default agent activated when OpenCode starts
  "default_agent": "OCA",

  // Global instruction files loaded for all agents
  "instructions": [
    "C:/Users/PC-3/.config/opencode/AGENTS.md",
    "C:/Users/PC-3/.config/opencode/instructions/*.md"
  ],

  // Custom commands: workflow-driven command system
  "command": {
    
    // STEP 1: Override built-in /init - Project initialization
    "init": {
      "description": "Initialize project: create AGENTS.md, tasks.yaml, .gitignore, run git init, run /bd-init (.beads/), and create ./plans/ directory",
      "template": "@Project_Initializer Initialize this project following the standard workflow:\n\n**Required Actions:**\n1. Scan codebase and create AGENTS.md (~150 lines):\n   - Build/lint/test commands (especially single test execution)\n   - Code style guidelines (imports, formatting, types, naming, error handling)\n   - Include existing rules from .cursor/rules/, .cursorrules, .github/copilot-instructions.md if present\n   - Follow Java/SpringBoot/Quarkus enterprise conventions\n\n2. Create tasks.yaml in project root following tasks-system.md canonical schema\n\n3. Create .gitignore appropriate for detected stack (Java/Maven/Gradle/SpringBoot/Quarkus)\n\n4. Run 'git init' to initialize repository (required for Beads persistence)\n\n5. Initialize Beads using OpenCode command: /bd-init (creates .beads/)\n\n6. Ensure .beads/ is included in .gitignore\n\n7. Create ./plans/ directory for plan storage\n\n**Context:**\n- Project path: $CWD\n- Stack hint: $ARGUMENTS\n\n**Use mcp-first skill:** Prefer Git MCP for initialization, fallback to bash only if needed." 
    },

    // STEP 2: Create new task in tasks.yaml
    "add-task": {
      "description": "Add a new task to tasks.yaml following the canonical schema",
      "template": "@Task_Manager Create a new task in ./tasks.yaml based on this input:\n\n$ARGUMENTS\n\n**Task Creation:**\n- Parse input to extract title and description\n- Generate next T-NNNN ID (parse existing, find max, increment, zero-pad to 4 digits)\n- Set status: TODO, delegable: true, priority: 3 (medium)\n- Initialize beads metadata with all fields null (mirrored: false)\n- Follow tasks-system.md canonical YAML structure exactly\n\n**Use task-workflow and beads-workflow skills for guidance.**"
    },

    // STEP 3: Override built-in /plan - Create implementation plan
    "plan": {
      "description": "Create detailed implementation plan for the next TODO+delegable task (saves to ./plans/plan-<task-id>.md)",
      "template": "@plan Create a comprehensive implementation plan for the next available AI task.\n\n**Task Selection (automatic):**\n1. Read ./tasks.yaml\n2. Identify candidate tasks where:\n   - status: TODO\n   - delegable: true\n3. If $ARGUMENTS contains a task ID (T-NNNN), plan that task ONLY if it matches status TODO and delegable true; otherwise stop and explain why\n4. If exactly ONE candidate exists, plan it automatically\n5. If zero candidates exist, stop and report: no TODO+delegable tasks available\n6. If more than one candidate exists, ask the user to choose which task ID to plan\n\n**Context Gathering:**\n- Extract from the selected task: task ID, title, description, priority, paths_hint, dont_touch_paths, notes\n- Use mcp-first skill: analyze codebase and review AGENTS.md conventions\n\n**Plan Requirements:**\n- Break down into atomic, testable implementation steps\n- Create step-by-step checklist for @build agent to follow sequentially\n- Identify all files to create/modify/delete\n- Note potential risks, edge cases, and dependencies\n- Respect dont_touch_paths safety boundaries\n- Include acceptance criteria from task notes\n\n**Output:**\n- Save to ./plans/plan-<task-id>.md\n- Use markdown sections: Task Context, Analysis, Implementation Checklist, Files Affected, Risks & Mitigations, Acceptance Criteria\n\n**Use task-workflow skill for task handling guidance.**"   
    },
    // STEP 4: Override built-in /build - Implement plan
    "build": {
      "description": "Implement plan from ./plans/plan-<task-id>.md with step-by-step execution and diff output",
      "template": "@build Implement the plan created by /plan.\n\n**Plan Selection (primary):**\n1. Use $ARGUMENTS as task ID (T-NNNN) and load plan from ./plans/plan-<task-id>.md\n\n**Plan Selection (fallbacks):**\n2. If $ARGUMENTS is empty, locate plan files ./plans/plan-*.md\n   - If exactly one plan exists, use it\n   - If more than one plan exists, ask the user which plan file to implement\n   - If none exist, stop and instruct user to run /plan first\n\n**Plan Loading:**\n- Read the selected plan file and follow its checklist sequentially (do NOT skip or reorder)\n- Treat the plan as authoritative for scope, constraints, and dont_touch_paths\n\n**Implementation Protocol:**\n- Generate clean, production-ready code following AGENTS.md conventions\n- Respect dont_touch_paths boundaries from the plan (stop and ask for approval if a restricted change is required)\n- After changes, provide a clear diff-style summary and list files modified/created\n\n**Restrictions (critical):**\n- NO test execution (unit tests, integration tests)\n- NO build/compile operations (Maven, Gradle)\n- NO deploy or lifecycle management\n- Implement code changes only; user handles validation"   
    },

    // STEP 5: Code review with APPROVE/REJECT decision
    "review": {
      "description": "Manual code review of current session changes (unstaged-first, staged fallback) with APPROVE/REJECT; separates AI blockers vs user warnings",
      "template": "@Code_Reviewer Review the code changes from this session.\n\n**Context Analysis:**\n1. Use mcp-first skill: analyze unstaged changes via git MCP (if none, fallback to staged changes)\n2. Check AGENTS.md for project-specific conventions\n3. OPTIONAL: If ./tasks.yaml exists and there is an active DOING task, use it as additional context (acceptance criteria, paths_hint, dont_touch_paths)\n4. Distinguish AI-generated vs user-written changes and apply the reject fallback strategy accordingly\n\n**Use code-review-checklist skill:**\n- Apply full checklist (Correctness, Security, Reliability, Maintainability, Performance, Observability, API, Config)\n- Issue clear APPROVE or REJECT decision\n- Provide checklist results, strengths, weaknesses, actionable feedback\n- Separate AI-Generated Code Issues (blockers) from User-Written Code Issues (warnings)\n- Focus on Java/SpringBoot/Quarkus best practices\n\n**Review Scope:** $ARGUMENTS (if empty, review all changes in session)"
    },

    // STEP 6: Generate Git/SVN commit commands
    "commit": {
      "description": "Generate copy-paste Git+SVN staging/commit/push commands and 2-3 Conventional Commit messages (task ref optional, never execute commands)",
      "template": "@Repo_Manager Generate commit commands for the current changes.\n\n**Context Gathering:**\n1. Use mcp-first skill: analyze changes via git MCP (prefer unstaged diff; if none, use staged diff), also get branch and recent history\n2. OPTIONAL: Read ./tasks.yaml only to add footer \"Refs: T-NNNN\" when there is an active DOING task (otherwise omit task references)\n3. ALWAYS generate BOTH Git and SVN command blocks, unless the user explicitly says \"no SVN\" or \"no Git\"\n\n**Use repo-commit-conventions skill:**\n- Generate Conventional Commits format: type(scope): description\n- Propose 2-3 alternative commit messages for user choice\n- Derive message from actual diff (must cover both AI and human changes)\n\n**Staging selection (interactive):**\n- Ask user to choose:\n  1) Stage ALL changes\n  2) Select FILES to stage (user will paste file paths)\n\n**Output (copy-paste ready):**\n1. Git commands: git status, git diff, git add (based on user choice), git commit -m \"<message>\", git push\n2. SVN commands: svn status, svn add (if needed), svn commit -m \"<message>\"\n\n**Critical:** DO NOT execute git/svn commands automatically. Only provide copy-paste ready commands.\n\n**Scope:** $ARGUMENTS"
    }
  },

  // Automatic update notification settings
  "autoupdate": "notify",

  // Session sharing configuration
  "share": "disabled",

  // Terminal UI theme
  "theme": "ayu",

  // Terminal UI settings
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": { "enabled": true },
    "diff_style": "auto"
  },

  // File watcher: directories to ignore
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".gitattributes/**",
      ".evo/**",
      ".yo-rc.json",
      "yo-rc-global.json",
      "target/**",        // Maven build output
      "build/**",         // Gradle build output
      ".mvn/**",          // Maven wrapper
      ".gradle/**",       // Gradle cache
      ".idea/**",         // IntelliJ IDEA
      ".vscode/**",       // VSCode
      "*.class",          // Java compiled classes
      "*.jar",            // Java archives
      "*.war"             // Web archives
    ]
  },

  // Token compaction settings
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Global permission baseline (security-first: deny by default, explicit allow per agent)
  "permission": {
    "read": "deny",
    "list": "deny",
    "glob": "deny",
    "grep": "deny",
    "lsp": "deny",
    "skill": "deny",
    "todoread": "deny",
    "todowrite": "deny",
    "webfetch": "deny",
    "task": "deny",
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "git*": "deny",
    "github*": "deny",
    "memory*": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  // Global tools baseline (security-first: disabled by default, explicit enable per agent)
  "tools": {
    "read": false,
    "list": false,
    "glob": false,
    "grep": false,
    "lsp": false,
    "skill": false,
    "webfetch": false,
    "task": false,
    "edit": false,
    "write": false,
    "bash": false,
    "git*": false,
    "github*": false,
    "memory*": false
  },

  // Agent configurations: each agent has specific role, permissions, and tools
  "agent": {

    // === PRIMARY AGENT: OCA (OpenCode Administrator) ===
    "OCA": {
      "description": "Primary orchestrator. Routes commands to sub-agents, validates workflow state, delegates code implementation to plan/build agents.",
      "prompt": "{file:./prompts/oca.txt}",
      "mode": "primary",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "task": "allow",
        "git*": "allow",
        "github*": "allow",
        "memory*": "allow"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "skill": true,
        "webfetch": true,
        "task": true,
        "bash": false,
        "edit": false,
        "write": false,
        "git*": true,
        "github*": true,
        "memory*": true
      },
      "max_steps": 5,
      "temperature": 0.2
    },

    // === SUB-AGENT 1: Project_Initializer ===
    "Project_Initializer": {
      "description": "Project initialization specialist. Creates AGENTS.md, tasks.yaml, .gitignore, runs git init, creates ./plans/ directory. Executes once per project.",
      "prompt": "{file:./prompts/project_initializer.txt}",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "bash": true,
        "write": true,
        "skill": true,
        "edit": false,
        "webfetch": false,
        "task": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 10,
      "temperature": 0.2
    },

    // === SUB-AGENT 2: Task_Manager ===
    "Task_Manager": {
      "description": "Task manager for ./tasks.yaml. Creates tasks (T-NNNN IDs), updates status, manages Beads integration for persistence. tasks.yaml is source of truth.",
      "prompt": "{file:./prompts/task_manager.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "allow",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "allow",
        "task": "allow",
        "git*": "deny",
        "github*": "deny",
        "memory*": "allow"
      },
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "list": true,
        "grep": true,
        "bash": false,
        "task": true,
        "skill": true,
        "webfetch": true,
        "lsp": false,
        "git*": false,
        "github*": false,
        "memory*": true
      },
      "max_steps": 10,
      "temperature": 0.2
    },

    // === SUB-AGENT 3: Code_Reviewer ===
    "Code_Reviewer": {
      "description": "Read-only code quality specialist. Reviews code against tasks.yaml requirements and best practices. Issues APPROVE/REJECT decision with actionable feedback.",
      "prompt": "{file:./prompts/code_reviewer.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "task": "deny",
        "git*": "deny",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "lsp": true,
        "bash": false,
        "skill": true,
        "webfetch": true,
        "edit": false,
        "write": false,
        "task": false,
        "git*": false,
        "github*": false,
        "memory*": false
      },
      "max_steps": 10,
      "temperature": 0.1
    },

    // === SUB-AGENT 4: Repo_Manager ===
    "Repo_Manager": {
      "description": "Repository command generator for Git and SVN. Analyzes changes, generates copy-paste ready shell commands with conventional commit messages. NEVER executes commands automatically.",
      "prompt": "{file:./prompts/repo_manager.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "allow",
        "memory*": "deny"
      },
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "list": true,
        "write": true,
        "skill": true,
        "edit": false,
        "lsp": false,
        "webfetch": false,
        "task": false,
        "git*": true,
        "github*": true,
        "memory*": false
      },
      "max_steps": 10,
      "temperature": 0.1
    }
  },

  // MCP (Model Context Protocol) servers configuration
  "mcp": {
    
    // Local Git MCP server
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/git-mcp-server"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "GIT_SIGN_COMMITS": "false"
      },
      "enabled": true,
      "timeout": 60000
    },

    // Remote GitHub MCP server
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "default",
        "X-MCP-Readonly": "true",
        "Authorization": "Bearer {env:OC_GITHUB_PAT}"
      },
      "enabled": true,
      "timeout": 15000
    },

    // Local Memory MCP server (knowledge graph persistence)
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:/Users/PC-3/.config/opencode/memory.jsonl"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
