{
  // Official schema for validation and editor autocomplete
  "$schema": "https://opencode.ai/config.json",

  // ============================================================================
  // PLUGINS
  // ============================================================================
  // OpenCode plugins to load
  "plugin": [
    "opencode-antigravity-auth@latest",   // Authentication management
    "opencode-beads@latest",               // AI-only task persistence, exposes @beads-task-agent subagent
    "@tarquinen/opencode-dcp@latest"       // DCP integration
  ],

  // ============================================================================
  // SERVER CONFIGURATION
  // ============================================================================
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "cors": ["http://localhost:5173"]
  },

  // Default agent activated when OpenCode starts
  "default_agent": "OCA",

  // Global instruction files loaded for all agents
  "instructions": [
    "C:/Users/PC-3/.config/opencode/AGENTS.md",
    "C:/Users/PC-3/.config/opencode/instructions/*.md"
  ],

  // ============================================================================
  // CUSTOM COMMANDS (Workflow-driven)
  // ============================================================================
  // IMPORTANT: Commands that require orchestration (two-step delegation) must
  // route through OCA. Commands with single-agent responsibility can call
  // the agent directly.
  //
  // Routing strategy:
  //   /init      → @Project_Initializer (single agent)
  //   /add-task  → @Task_Manager (single agent)
  //   /plan      → @OCA (two-step: Task_Manager → plan)
  //   /build     → @OCA (validation + single agent)
  //   /review    → @OCA (two-step: Code_Reviewer → Task_Manager)
  //   /commit    → @Repo_Manager (single agent)
  // ============================================================================
  "command": {
    
    // STEP 1: Project initialization (single agent, no orchestration needed)
    "init": {
      "description": "Initialize project: create AGENTS.md, tasks.yaml, .gitignore, run git init, run beads:init (.beads/), and create ./plans/ directory",
      "template": "@Project_Initializer Initialize this project following the standard workflow:\n\n**Required Actions:**\n1. Scan codebase and create AGENTS.md (~150 lines):\n   - Build/lint/test commands (especially single test execution)\n   - Code style guidelines (imports, formatting, types, naming, error handling)\n   - Include existing rules from .cursor/rules/, .cursorrules, .github/copilot-instructions.md if present\n   - Follow Java/SpringBoot/Quarkus enterprise conventions\n\n2. Create tasks.yaml in project root following tasks-system.md canonical schema\n\n3. Create .gitignore appropriate for detected stack (Java/Maven/Gradle/SpringBoot/Quarkus)\n\n4. Run 'git init' to initialize repository (required for Beads persistence)\n\n5. Initialize Beads using OpenCode command: beads:init (creates .beads/). Fallback to bash 'bd init' if the OpenCode command is unavailable.\n\n6. Ensure .beads/ is included in .gitignore\n\n7. Create ./plans/ directory for plan storage\n\n**Context:**\n- Project path: $CWD\n- Stack hint: $ARGUMENTS\n\n**Use mcp-first skill:** Prefer Git MCP for initialization, fallback to bash only if needed."
    },

    // STEP 2: Create new task (single agent, no orchestration needed)
    "add-task": {
      "description": "Add a new task to tasks.yaml following the canonical schema",
      "template": "@Task_Manager Create a new task in ./tasks.yaml based on this input:\n\n$ARGUMENTS\n\n**Task Creation:**\n- Parse input to extract title and description\n- Generate next T-NNNN ID (parse existing, find max, increment, zero-pad to 4 digits)\n- Set status: TODO, delegable: true, priority: 3 (medium)\n- Initialize beads metadata with all fields null (mirrored: false)\n- Follow tasks-system.md canonical YAML structure exactly\n\n**Use task-workflow and beads-workflow skills for guidance.**"
    },

    // STEP 3: Plan creation (TWO-STEP ORCHESTRATION via OCA)
    // Flow: OCA validates → Task_Manager (TODO→DOING + Beads) → plan (creates plan file)
    "plan": {
      "description": "Create implementation plan (two-step: Task_Manager updates status, then plan creates plan file)",
      "template": "@OCA Orchestrate /plan command with two-step delegation.\n\n**Input:** $ARGUMENTS\n\n**Required Orchestration (follow EXACTLY):**\n\n**Step 1: Validate Prerequisites**\n- Check ./tasks.yaml exists\n- Check ./AGENTS.md exists\n- If missing: STOP with error message\n\n**Step 2: Delegate to @Task_Manager**\nPass this exact instruction:\n\"Pre-planning workflow for /plan command.\nInput: $ARGUMENTS\nActions required:\n1. Parse input to extract task ID (T-NNNN) or detect auto-select mode (empty)\n2. If specific task: validate exists, status=TODO, delegable=true\n3. If auto-select: find highest priority TODO+delegable task\n4. Update task status: TODO → DOING\n5. Mirror to Beads (create issue via @beads-task-agent)\n6. Output confirmation and TERMINATE\"\n\n**Step 3: After Task_Manager completes, delegate to @plan**\nPass this exact instruction:\n\"Create implementation plan for the task now in DOING status.\nActions required:\n1. Read tasks.yaml, find task with status=DOING\n2. If no DOING task found: ERROR (Task_Manager should have set one)\n3. Analyze codebase and create detailed implementation plan\n4. Save plan to ./plans/plan-<task-id>.md\n5. Output confirmation with plan summary\"\n\n**Critical:** Complete BOTH steps before returning to user."
    },

    // STEP 4: Build implementation (validation via OCA, then built-in build agent)
    "build": {
      "description": "Implement plan from ./plans/plan-<task-id>.md with step-by-step execution",
      "template": "@OCA Orchestrate /build command.\n\n**Input:** $ARGUMENTS\n\n**Step 1: Validate Prerequisites**\n- Check ./tasks.yaml exists\n- Check ./AGENTS.md exists\n- If $ARGUMENTS contains task ID: verify task exists with status=DOING\n- Verify plan file exists: ./plans/plan-<task-id>.md\n- If any validation fails: STOP with error message\n\n**Step 2: Delegate to @build**\nPass this instruction:\n\"Implement the plan created by /plan.\n\n**Plan Selection (primary):**\n1. Use $ARGUMENTS as task ID (T-NNNN) and load plan from ./plans/plan-<task-id>.md\n\n**Plan Selection (fallbacks):**\n2. If $ARGUMENTS is empty, locate plan files ./plans/plan-*.md\n   - If exactly one plan exists, use it\n   - If more than one plan exists, ask the user which plan file to implement\n   - If none exist, stop and instruct user to run /plan first\n\n**Implementation Protocol:**\n- Read the selected plan file and follow its checklist sequentially (do NOT skip or reorder)\n- Treat the plan as authoritative for scope, constraints, and dont_touch_paths\n- Generate clean, production-ready code following AGENTS.md conventions\n- Respect dont_touch_paths boundaries (stop and ask for approval if restricted change required)\n- After changes, provide clear diff-style summary and list files modified/created\n\n**Restrictions (critical):**\n- NO test execution (unit tests, integration tests)\n- NO build/compile operations (Maven, Gradle)\n- NO deploy or lifecycle management\n- Implement code changes only; user handles validation\""
    },

    // STEP 5: Code review (TWO-STEP ORCHESTRATION via OCA)
    // Flow: OCA validates → Code_Reviewer (APPROVE/REJECT) → Task_Manager (status update)
    "review": {
      "description": "Code review with APPROVE/REJECT decision (two-step: Code_Reviewer reviews, then Task_Manager updates status)",
      "template": "@OCA Orchestrate /review command with two-step delegation.\n\n**Input:** $ARGUMENTS\n\n**Required Orchestration (follow EXACTLY):**\n\n**Step 1: Validate Prerequisites**\n- Check ./tasks.yaml exists (optional for review, but needed for status update)\n- If missing: WARN but continue (review can work without tasks)\n\n**Step 2: Delegate to @Code_Reviewer**\nPass this instruction:\n\"Review the code changes from this session.\n\n**Context Analysis:**\n1. Use git* MCP tools to analyze unstaged changes (if none, fallback to staged changes)\n2. Check AGENTS.md for project-specific conventions\n3. OPTIONAL: If ./tasks.yaml exists and there is an active DOING task, use it as context\n4. Distinguish AI-generated vs user-written changes\n\n**Apply code-review-checklist skill:**\n- Full checklist (Correctness, Reliability, Maintainability, Performance, Observability, Config)\n- Issue clear APPROVE or REJECT decision\n- Separate AI-Generated Code Issues (blockers) from User-Written Code Issues (warnings)\n\n**Review Scope:** $ARGUMENTS (if empty, review all changes)\n\n**Output Format:**\nDecision: [APPROVE/REJECT]\nAI_Blockers: [list or 'none']\nUser_Warnings: [list or 'none']\nSummary: [brief review summary]\n\nTERMINATE after outputting review results.\"\n\n**Step 3: After Code_Reviewer completes, delegate to @Task_Manager**\nPass this instruction with the review results:\n\"Post-review status update.\n\n**Review Decision:** [extract from Code_Reviewer output]\n**AI Blockers:** [extract from Code_Reviewer output]\n**User Warnings:** [extract from Code_Reviewer output]\n\n**Actions required:**\n1. Read tasks.yaml, find task with status=DOING\n2. If no DOING task: Skip status update (review was for non-task changes)\n3. If DOING task found, apply status update:\n   - If APPROVE: DOING → DONE, close Beads issue\n   - If REJECT with AI blockers: DOING → BLOCKED, update Beads with blockers\n   - If REJECT with only user warnings: DOING → DONE (warnings non-blocking)\n4. Output confirmation and TERMINATE\"\n\n**Critical:** Complete BOTH steps before returning to user."
    },

    // STEP 6: Commit commands (single agent, no orchestration needed)
    "commit": {
      "description": "Generate copy-paste Git+SVN staging/commit/push commands and 2-3 Conventional Commit messages",
      "template": "@Repo_Manager Generate commit commands for the current changes.\n\n**Context Gathering:**\n1. Use mcp-first skill: analyze changes via git MCP (prefer unstaged diff; if none, use staged diff), also get branch and recent history\n2. OPTIONAL: Read ./tasks.yaml only to add footer \"Refs: T-NNNN\" when there is exactly one DOING task AND changes touch files in task's paths_hint (otherwise omit task references)\n3. ALWAYS generate BOTH Git and SVN command blocks, unless the user explicitly says \"no SVN\" or \"no Git\"\n\n**Use repo-commit-conventions skill:**\n- Generate Conventional Commits format: type(scope): description\n- Propose 2-3 alternative commit messages for user choice\n- Derive message from actual diff (must cover both AI and human changes)\n\n**Staging selection (interactive):**\n- Ask user to choose:\n  1) Stage ALL changes\n  2) Select FILES to stage (user will paste file paths)\n\n**Output (copy-paste ready):**\n1. Git commands: git status, git diff, git add (based on user choice), git commit -m \"<message>\", git push\n2. SVN commands: svn status, svn add (if needed), svn commit -m \"<message>\"\n\n**Critical:** DO NOT execute git/svn commands automatically. Only provide copy-paste ready commands.\n\n**Scope:** $ARGUMENTS"
    }
  },

  // ============================================================================
  // UI AND BEHAVIOR SETTINGS
  // ============================================================================
  "autoupdate": "notify",
  "share": "disabled",
  "theme": "ayu",

  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": { "enabled": true },
    "diff_style": "auto"
  },

  // File watcher: directories to ignore
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".gitattributes/**",
      ".evo/**",
      ".yo-rc.json",
      "yo-rc-global.json",
      "target/**",
      "build/**",
      ".mvn/**",
      ".gradle/**",
      ".idea/**",
      ".vscode/**",
      "*.class",
      "*.jar",
      "*.war"
    ]
  },

  // Token compaction settings
  "compaction": {
    "auto": true,
    "prune": true
  },

  // ============================================================================
  // GLOBAL PERMISSIONS AND TOOLS (Security-first baseline)
  // ============================================================================
  // Default: deny all. Each agent explicitly enables what it needs.
  "permission": {
    "read": "deny",
    "list": "deny",
    "glob": "deny",
    "grep": "deny",
    "lsp": "deny",
    "skill": "deny",
    "todoread": "deny",
    "todowrite": "deny",
    "webfetch": "deny",
    "task": "deny",
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "git*": "deny",
    "github*": "deny",
    "memory*": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "tools": {
    "read": false,
    "list": false,
    "glob": false,
    "grep": false,
    "lsp": false,
    "skill": false,
    "webfetch": false,
    "task": false,
    "edit": false,
    "write": false,
    "bash": false,
    "git*": false,
    "github*": false,
    "memory*": false
  },

  // ============================================================================
  // AGENT CONFIGURATIONS
  // ============================================================================
  "agent": {

    // =========================================================================
    // PRIMARY AGENT: OCA (OpenCode Administrator)
    // =========================================================================
    // Role: Orchestrator for workflow commands. Validates prerequisites and
    //       manages multi-step delegations (/plan, /review).
    // Does NOT: Implement code, modify tasks.yaml directly, execute builds.
    "OCA": {
      "description": "Primary orchestrator. Validates workflow state, routes commands to sub-agents, manages two-step delegations for /plan and /review.",
      "prompt": "{file:./prompts/oca.txt}",
      "mode": "primary",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "allow",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "skill": true,
        "webfetch": false,
        "task": true,
        "bash": false,
        "edit": false,
        "write": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 15,
      "temperature": 0.2
    },

    // =========================================================================
    // SUB-AGENT: Project_Initializer
    // =========================================================================
    // Role: One-time project setup. Creates AGENTS.md, tasks.yaml, .gitignore,
    //       initializes git, beads, and ./plans/ directory.
    // Trigger: /init command
    "Project_Initializer": {
      "description": "Project initialization specialist. Creates AGENTS.md, tasks.yaml, .gitignore, runs git init, beads:init, creates ./plans/. Executes ONCE per project.",
      "prompt": "{file:./prompts/project_initializer.txt}",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "bash": true,
        "write": true,
        "skill": true,
        "edit": true,
        "webfetch": false,
        "task": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 15,
      "temperature": 0.2
    },

    // =========================================================================
    // SUB-AGENT: Task_Manager
    // =========================================================================
    // Role: Authoritative manager for tasks.yaml. Creates tasks, manages status
    //       transitions, handles Beads integration via @beads-task-agent.
    // Triggers: /add-task, delegation from OCA for /plan and /review
    // Note: Delegates Beads operations to @beads-task-agent (from opencode-beads plugin)
    "Task_Manager": {
      "description": "Task manager for ./tasks.yaml. Creates tasks (T-NNNN IDs), updates status (TODO/DOING/DONE/BLOCKED/SKIP), manages Beads integration. tasks.yaml is source of truth.",
      "prompt": "{file:./prompts/task_manager.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "allow",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "allow",
        "git*": "deny",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "list": true,
        "grep": true,
        "bash": false,
        "task": true,
        "skill": true,
        "webfetch": false,
        "lsp": false,
        "git*": false,
        "github*": false,
        "memory*": false
      },
      "max_steps": 12,
      "temperature": 0.2
    },

    // =========================================================================
    // SUB-AGENT: plan
    // =========================================================================
    // Role: Implementation planning specialist. Analyzes codebase and creates
    //       detailed implementation plans saved to ./plans/plan-<task-id>.md.
    // Trigger: Delegation from OCA after Task_Manager completes TODO→DOING
    // Expects: Task already in DOING status (set by Task_Manager)
    "plan": {
      "description": "Implementation planning specialist. Creates ./plans/plan-<task-id>.md for task in DOING status. Does NOT update task status (Task_Manager already did).",
      "prompt": "{file:./prompts/plan.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "deny",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "edit": true,
        "write": true,
        "lsp": true,
        "skill": true,
        "bash": false,
        "webfetch": false,
        "task": false,
        "git*": false,
        "github*": false,
        "memory*": false
      },
      "max_steps": 15,
      "temperature": 0.3
    },

    // =========================================================================
    // BUILT-IN AGENT: build
    // =========================================================================
    // Role: Implementation specialist. Reads plan from ./plans/plan-<task-id>.md
    //       and implements code changes following the checklist.
    // Trigger: Delegation from OCA after /build validation
    // Note: Uses OpenCode's default build agent. No custom prompt needed.
    //       Permissions/tools inherited from OpenCode defaults.
    "build": {
      "description": "Implementation specialist. Reads plan from ./plans/plan-<task-id>.md and implements code changes following the checklist.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "edit": true,
        "write": true,
        "bash": false,
        "lsp": true,
        "skill": true,
        "webfetch": false,
        "task": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 25,
      "temperature": 0.2
    },

    // =========================================================================
    // SUB-AGENT: Code_Reviewer
    // =========================================================================
    // Role: Read-only code quality specialist. Reviews changes against checklist,
    //       issues APPROVE/REJECT decision, distinguishes AI blockers vs user warnings.
    // Trigger: Delegation from OCA for /review (first step)
    // Note: Does NOT update task status. OCA delegates to Task_Manager after review.
    "Code_Reviewer": {
      "description": "Read-only code quality specialist. Reviews code against checklist and best practices. Issues APPROVE/REJECT with actionable feedback. Separates AI blockers from user warnings.",
      "prompt": "{file:./prompts/code_reviewer.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "lsp": true,
        "bash": false,
        "skill": true,
        "webfetch": false,
        "edit": false,
        "write": false,
        "task": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 12,
      "temperature": 0.1
    },

    // =========================================================================
    // SUB-AGENT: Repo_Manager
    // =========================================================================
    // Role: Repository command generator. Analyzes changes via MCP, generates
    //       copy-paste ready Git+SVN commands with Conventional Commit messages.
    // Trigger: /commit command
    // CRITICAL: NEVER executes git/svn commands. Only generates copy-paste output.
    "Repo_Manager": {
      "description": "Repository command generator for Git and SVN. Analyzes changes, generates copy-paste ready commands with Conventional Commit messages. NEVER executes commands automatically.",
      "prompt": "{file:./prompts/repo_manager.txt}",
      "mode": "subagent",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "deny",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny",
        "git*": "allow",
        "github*": "deny",
        "memory*": "deny"
      },
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "list": true,
        "write": false,
        "skill": true,
        "edit": false,
        "lsp": false,
        "webfetch": false,
        "task": false,
        "git*": true,
        "github*": false,
        "memory*": false
      },
      "max_steps": 10,
      "temperature": 0.1
    }

    // =========================================================================
    // PLUGIN AGENT: beads-task-agent (provided by opencode-beads)
    // =========================================================================
    // Role: Handles Beads operations (create/update/close issues).
    // Trigger: Delegation from Task_Manager for Beads sync.
    // Note: This agent is provided by the opencode-beads plugin, not configured here.
    //       Task_Manager delegates to @beads-task-agent for all Beads operations.
  },

  // ============================================================================
  // MCP (Model Context Protocol) SERVERS
  // ============================================================================
  "mcp": {
    
    // Local Git MCP server - Primary tool for repository inspection
    // Tools: status, diff, log, branch, etc.
    // Note: Verify available tools match what agents expect (e.g., blame may not exist)
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/git-mcp-server"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "GIT_SIGN_COMMITS": "false"
      },
      "enabled": true,
      "timeout": 60000
    },

    // Remote GitHub MCP server - For GitHub-specific operations (PRs, issues, etc.)
    // Currently READ-ONLY (X-MCP-Readonly: true)
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "default",
        "X-MCP-Readonly": "true",
        "Authorization": "Bearer {env:OC_GITHUB_PAT}"
      },
      "enabled": true,
      "timeout": 15000
    },

    // Local Memory MCP server - Knowledge graph persistence
    // Used for: user preferences, repo conventions, stable context
    // NOT used for: secrets, credentials, sensitive data
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:/Users/PC-3/.config/opencode/memory.jsonl"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
