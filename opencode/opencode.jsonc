{
  // Schema ufficiale per validation/autocomplete editor
  "$schema": "https://opencode.ai/config.json",

  //Plugins
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-beads@latest",
    "@tarquinen/opencode-dcp@latest"
  ],

  //Configurazione server locale OpenCode
  "server": {
    "port": 4096,
    "hostname": "localhost",
    "mdns": true,
    "cors": ["http://localhost:5173"]
  },

  //Agente impostato di default
  "default_agent": "plan",
  
  "instructions": [
    "C:/Users/PC-3/.config/opencode/AGENTS.md",
    "C:/Users/PC-3/.config/opencode/instructions/*.md"
  ],

  "command": {

    "init-git": {
      "description": "Initialize Git repository with .gitignore",
      "template": "@Repo_Manager Initialize Git repository:\n\n1. Run: git init\n2. Create .gitignore file (only if it doesn't already exist) with appropriate entries for this project type based on the codebase analysis",
      "agent": "Command_Runner"
    },

    "init": {
      "description": "create/update AGENTS.md",
      "template": "@build Please analyze this codebase and create an AGENTS.md file containing:\n\n1. Build and lint commands\n2. Code style guidelines including:\n   - Import conventions\n   - Formatting rules\n   - Type usage\n   - Naming conventions\n   - Error handling patterns\n   - Any company-specific coding standards\n\nThe file you create will be given to agentic coding agents (such as yourself) that operate in this  sitory. Make it about 150 lines long.\n\nIf there are Cursor rules (in .cursor/rules/ or .cursorrules) or Copilot rules (in .github/copilot-instructions.md), make sure to include them.\n\nIf there's already an AGENTS.md in the root, improve it based on the current codebase.",
      "agent": "Command_Runner"
    },

    "create-task-file": {
      "description": "Create standard tasks.yaml file in project root",
      "template": "@Task_Manager Create a tasks.yaml file in the project root following the schema defined in the instructions (tasks-system.md). Initialize it with one sample task for project setup with status DONE. Use current date for created and updated fields.",
      "agent": "Command_Runner"
    },

    "add-task": {
      "description": "Add a new task to tasks.yaml",
      "template": "@Task_Manager Add a new task to tasks.yaml based on this input:\n\n$ARGUMENTS\n\nParse the input to extract title and description, assign the next available ID, set status to TODO, use priority 3 (medium) by default, and add current date for created/updated fields.",
      "agent": "Command_Runner"
    },

    "review": {
      "description": "Review recent code changes against tasks and best practices",
      "template": "@Code_Reviewer Review the code changes made in this session using the code-review-checklist skill. Verify alignment with current task requirements from tasks.yaml, check code quality and best practices, identify potential issues. Provide clear APPROVE or REJECT decision with actionable feedback.",
      "agent": "Command_Runner"
    },

    "commit": {
      "description": "Generate Git/SVN commit commands for current changes",
      "template": "@Repo_Manager Using the repo-commit-conventions skill, analyze the changes in this session and generate commit commands for both Git and SVN (if applicable). Use conventional commit format based on tasks.yaml context. Provide copy-paste ready shell commands.",
      "agent": "Command_Runner"
    }
  },

  //Impostazione aggiornamento automatico
  "autoupdate": "notify",

  //Impostazione condivisione sessioni
  "share": "disabled",

  //Tema predefinito
  "theme": "ayu",

  //TUI: Impostazioni terminale
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": { "enabled": true },
    "diff_style": "auto"
  },

  //Watcher ignore: Directory da ignorare
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".gitattributes/**",
      ".evo/**",
      ".yo-rc.json",
      "yo-rc-global.json"
    ]
  },

  //Compaction: Token compation
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Permission baseline (nota: git* / github* qui sono solo policy, il gating reale è in "tools")
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "task": "allow",
    "edit": "allow",
    "bash": "allow",
    "git*": "allow",
    "github*": "allow",
    "memory*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "tools": {
    "git*": true,
    "github*": true,
    "memory*": true
  },

  "agent": {
    "Command_Runner": {
      "description": "Specialized agent for executing user-provided shell commands, initialization routines. Strictly limited to command execution; does not plan, write code, or perform analysis.",
      "prompt": "{file:./prompts/command_runner.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": {
        "bash": true,
        "list": true,
        "glob": true,
        "write": true,
        "git*": false,
        "github*": false
      },
      "max_steps": 5,
      "temperature": 0.1
    },

    "Task_Manager": {
      "description": "Manages tasks.yaml file and basic file creation like tasks.yaml: creates new tasks from user input, updates status (TODO/DOING/DONE/BLOCKED/SKIP), adds notes/paths, integrates beads for session-persistent memory. Reads project context and tasks history; no code implementation or planning.",
      "prompt": "{file:./prompts/task_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "allow",
        "task": "allow"
      },
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "bash": true,
        "task": true,
        "skill": true,
        "git*": false,
        "github*": false,
        "memory*": true
      },
      "max_steps": 10,
      "temperature": 0.2
    },

    "plan": {
      "tools": {
        "git*": true,
        "github*": true,
        "memory*": true
      }
    },

    "Code_Reviewer": {
      "description": "Reviews generated code changes and diffs against tasks.yaml and software engineering best practices. Evaluates code quality, scalability, and maintainability. Approves solid implementations or rejects with actionable feedback for re-planning.",
      "prompt": "{file:./prompts/code_reviewer.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "high",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "write": "deny",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "task": "deny"
      },
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "lsp": true,
        "bash": true,
        "skill": true,
        "webfetch": true,
        "git*": false,
        "github*": false
      },
      "max_steps": 10,
      "temperature": 0.1
    },

    "Repo_Manager": {
      "description": "Manages Git/SVN repositories: initializes repos, creates .gitignore, generates commit commands. For commits: suggests conventional messages from tasks.yaml, shows status/diffs. For init: executes git init and creates appropriate .gitignore.",
      "prompt": "{file:./prompts/repo_manager.txt}",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permissions": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "allow",
        "lsp": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "task": "deny"
      },
      "tools": {
        "bash": false,
        "glob": true,
        "grep": true,
        "read": true,
        "list": true,
        "write": true,
        "skill": true,
        "git*": true,
        "github*": true
      },
      "max_steps": 8,
      "temperature": 0.1
    }
  },

  "mcp": {
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/git-mcp-server"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "GIT_SIGN_COMMITS": "false"
      },
      "enabled": true,
      "timeout": 60000
    },

    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "default",
        "X-MCP-Readonly": "true",
        "Authorization": "Bearer {env:OC_GITHUB_PAT}"
      },
      "enabled": true,
      "timeout": 15000
    },

    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:/Users/PC-3/.config/opencode/memory.jsonl"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
